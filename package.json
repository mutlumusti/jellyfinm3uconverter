{
    "name": "iptv-processor",
    "version": "1.0.0",
    "description": "Jellyfin için Otomatik IPTV Playlist İşleyici",
    "main": "electron/main.js",
    "type": "module",
    "scripts": {
        "start": "electron .",
        "server": "node src/server.js",
        "dev": "node --watch src/server.js",
        "build": "electron-builder",
        "build:msi": "electron-builder --win msi",
        "build:nsis": "electron-builder --win nsis",
        "dist": "electron-builder --win"
    },
    "keywords": [
        "iptv",
        "m3u",
        "jellyfin",
        "strm",
        "playlist",
        "electron"
    ],
    "author": "Mustafa Mutlu",
    "license": "MIT",
    "dependencies": {
        "axios": "^1.6.7",
        "express": "^4.18.2",
        "node-cron": "^3.0.3",
        "socket.io": "^4.7.4",
        "uuid": "^9.0.1"
    },
    "devDependencies": {
        "electron": "^28.1.0",
        "electron-builder": "^24.9.1"
    }
}